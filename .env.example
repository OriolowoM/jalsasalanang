# ========================================================
# Jalsa Salana Nigeria — Production Environment (.env)
# ========================================================

# 1. DATABASE (Your cPanel MySQL Credentials)
# Replace 'YOUR_PASSWORD' with the password you set for user 'ahmabumi_jalsauser'
DATABASE_URL="mysql://ahmabumi_jalsauser:YOUR_PASSWORD@localhost:3306/ahmabumi_jalsa"

# 2. APPLICATION SECRETS
JWT_SECRET="jalsa_salana_nigeria_jwt_secret_token_key_2026_editorial_platform"
JWT_EXPIRES_IN="7d"

# 3. ENVIRONMENT & PORT
PORT=3000
NODE_ENV="production"

# 4. URLs (Replace with your live domain name, e.g. https://jalsasalana.ng)
FRONTEND_URL="https://jalsasalana.ng"
NEXT_PUBLIC_API_URL="https://jalsasalana.ng/api/v1"

# 5. GOOGLE GEMINI AI (Enables Jalsa Concierge & Multilingual Translations)
GEMINI_API_KEY="your_gemini_api_key_here"
GEMINI_MODEL="gemini-2.5-flash"
